<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Mucan54_IkasImport::ikas" title="Ikas Import" sortOrder="100">
                    <resource id="Mucan54_IkasImport::import" title="Import Products" sortOrder="10"/>
                    <resource id="Mucan54_IkasImport::config" title="Configuration" sortOrder="20"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Mucan54_IkasImport::config" title="Ikas Import Configuration"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
